# ===========================================================================
# Connect With The Empire â€” platform configuration
# ===========================================================================
# Connect With The Empire is the SaaS platform. SACCOs are the paying customers; each
# SACCO is a tenant that manages its own members underneath it.
#
#   Connect With The Empire (platform)
#     â””â”€ SACCO  (tenant)  pays UGX 50,000 / month
#          â””â”€ Member  (the SACCO's own client)
#
# ===========================================================================

# ---------------------------------------------------------------------------
# Database â€” Postgres. In production this must be a managed instance with
# point-in-time recovery (Neon / Supabase / RDS).
#
# Local dev has no Docker requirement: `npm run db:install-embedded` fetches a
# private Postgres binary into node_modules (kept out of package.json so Vercel
# never installs it), then `npm run db:start` and `npm run db:migrate`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://empires:sacco@localhost:5432/empires_connect
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Auth â€” generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying-please
API_KEY_PEPPER=dev-only-insecure-pepper-change-me-before-deploying-please

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
PLATFORM_NAME=Connect With The Empire
PLATFORM_TAGLINE=The digital backbone for Ugandan SACCOs

# ---------------------------------------------------------------------------
# Subscription billing â€” the PLATFORM's account, into which every SACCO pays.
# These strings appear on every invoice, reminder SMS, the signup page and the
# docs, so treat them as audited configuration rather than free text.
#
# VERIFY THE ACCOUNT NUMBER BEFORE GOING LIVE: it is printed on the public
# signup page. A typo sends real subscription money to the wrong account.
# ---------------------------------------------------------------------------
BILLING_BANK_NAME=Standard Chartered Bank Uganda
BILLING_ACCOUNT_NUMBER=0100824048800
BILLING_ACCOUNT_NAME=Connect With The Empire
BILLING_CURRENCY=UGX

BILLING_PLAN_NAME=Connect With The Empire Standard
BILLING_PLAN_PRICE=50000
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
BILLING_DATA_RETENTION_DAYS=90

# SACCO self-signup. When false, /api/auth/register and /signup return 403 and
# tenants are provisioned manually by the platform owner. Turn this off if you
# ever need to approve every new SACCO before granting a trial.
ALLOW_SACCO_SELF_SIGNUP=true

# Domains that may be used to send transactional mail on signup confirmations.
SIGNUP_ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# SMS gateway (Africa's Talking or equivalent). Leave blank to use the stub
# provider, which logs instead of sending. NEVER expose these to the browser.
# ---------------------------------------------------------------------------
AT_USERNAME=
AT_API_KEY=
AT_SANDBOX=true

# ---------------------------------------------------------------------------
# Email alerts (Resend). Blank key = stub transport, which logs instead of
# sending â€” so a fresh deploy can never mail real people by accident.
#
# Resend will only deliver to the account owner's own address until you verify
# a sending domain. Set EMAIL_FROM to an address on that verified domain.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Connect With The Empire <alerts@empiresconnect.com>

# ---------------------------------------------------------------------------
# WhatsApp alerts (Meta WhatsApp Cloud API).
#
# Create a Meta app -> WhatsApp -> API setup, then copy the phone number id and
# a permanent access token. A message the member did not start must be an
# APPROVED TEMPLATE, so WHATSAPP_TEMPLATE_NAME is effectively required in
# production; leave it blank only for the 24-hour session window.
#
# WhatsApp templates use positional placeholders ({1}, {2}, ...). The variables
# sent are, in order: amount, balance, reference â€” your approved template body
# must match that order.
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_SIGNUP_PER_HOUR=5

# ---------------------------------------------------------------------------
# Public base URL â€” used in API docs, confirmation emails and signup links.
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# Comma-separated bootstrap emails promoted to super_admin on seed.
SUPER_ADMIN_EMAILS=

# Bearer secret for the cron endpoint. Required in production.
CRON_SECRET=
